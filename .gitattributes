# Byte-exact vendored content. The vendor-sync doctor check and 3-way merges compare git blob
# hashes of upstream base copies (vendor/upstream/) and of whole-file verbatim items, which live
# in place under plugin/builtins/ and plugin/agents/. A Windows checkout with autocrlf would
# convert their line endings and break those hashes, so none of it is ever converted.
# test/vendored-text-attributes.test.js fails if a merge-tracked verbatim item is left uncovered.
vendor/upstream/** -text
plugin/builtins/** -text
plugin/agents/** -text
# Generated Claude plugin runtime (scripts/build-plugin-runtime.mjs): stored byte-exact so
# `npm run check:plugin` can compare it with a fresh build. Never hand-merge it: rebuild it.
plugin/runtime/cli/** -text -diff linguist-generated=true
