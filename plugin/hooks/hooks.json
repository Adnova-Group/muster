{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell|mcp__(?!ccd_).*)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use.js"],
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
